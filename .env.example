# Copy to .env and adjust. Every value can also be set as a real environment
# variable (takes precedence over this file).

# --- Application -------------------------------------------------------------
# development | testing | staging | production
ENVIRONMENT=development
DEBUG=false

# --- Database ----------------------------------------------------------------
# Local development default is SQLite (no setup). Production requires Postgres.
# DATABASE_URL=postgresql+asyncpg://ats:ats_password@localhost:5432/ats_pm
DATABASE_URL=sqlite+aiosqlite:///./ats_pm.db

# --- Auth --------------------------------------------------------------------
# Must be >=32 random characters in production (enforced at startup).
JWT_SECRET_KEY=generate-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5000
CORS_ALLOW_LOCAL_DEV=true

# --- Rate limiting -------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10/minute

# --- Storage (local | s3 | r2 | azure) ---------------------------------------
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=26214400
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT_URL=            # set for Cloudflare R2 / MinIO
# AZURE_CONTAINER=
# AZURE_CONNECTION_STRING=

# --- Cache (memory | redis | none) -------------------------------------------
CACHE_BACKEND=memory
# REDIS_URL=redis://localhost:6379/0

# --- Queue (inline | celery) ---------------------------------------------------
QUEUE_BACKEND=inline

# --- Logging -------------------------------------------------------------------
LOG_LEVEL=INFO
# LOG_JSON=true               # default: JSON in staging/production

# --- Migrations ----------------------------------------------------------------
RUN_MIGRATIONS_ON_STARTUP=true
